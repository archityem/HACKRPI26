# Copy to .env.local and fill in. Everything is optional for local development.

# Gemini: without a key, AI features are off and the app uses sample destinations.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash   # optional: try this model first

# Upstash Redis (production storage). Without these, trips are saved to data/db.json.
# On Vercel, adding the Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
